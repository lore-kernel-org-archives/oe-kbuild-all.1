---

tree:   https://android.googlesource.com/kernel/common android-mainline
head:   2dbb0451810f9e63c61e974cbc490f3b75384b63
commit: 2dbb0451810f9e63c61e974cbc490f3b75384b63 [1/1] ANDROID: Incremental=
 fs: Support xattrs
:::::: branch date: 9 hours ago
:::::: commit date: 9 hours ago

 vfs.c |    3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

--- a/fs/incfs/vfs.c
+++ b/fs/incfs/vfs.c
@@ -2118,11 +2118,10 @@ static ssize_t incfs_setxattr(struct den
 	}

 	kfree (*stored_value);
-	*stored_value =3D kzalloc(size, GFP_NOFS);
+	*stored_value =3D kmemdup(value, size, GFP_NOFS);
 	if (!*stored_value)
 		return -ENOMEM;

-	memcpy(*stored_value, value, size);
 	*stored_size =3D size;
 	return 0;
 }
