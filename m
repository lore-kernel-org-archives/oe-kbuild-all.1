   655			if (wb) {
   656				struct cgroup_subsys_state *blkcg_css;
   657	=

   658				/* see whether the blkcg association has changed */
   659				blkcg_css =3D cgroup_get_e_css(memcg_css->cgroup,
   660							     &io_cgrp_subsys);
   661				if (unlikely(wb->blkcg_css !=3D blkcg_css ||
