   870		ret = btrfs_wait_ordered_range(inode_in, ALIGN_DOWN(pos_in, bs),
   871					       wb_len);
   872		if (ret < 0)
   873			return ret;
   874		ret = btrfs_wait_ordered_range(inode_out, ALIGN_DOWN(pos_out, bs),
   875					       wb_len);
   876		if (ret < 0)
   877			return ret;
   878	
   879		return generic_remap_file_range_prep(file_in, pos_in, file_out, pos_out,
