   966			ni_lock(ni);
   967			std = ni_std5(ni);
   968			if (!std) {
   969				err = -EINVAL;
   970			} else if (std->security_id != security_id) {
   971				std->security_id = ni->std_security_id = security_id;
   972				/* Std attribute always in primary record. */
   973				ni->mi.dirty = true;
   974				mark_inode_dirty(&ni->vfs_inode);
   975			}
