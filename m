   611		ret = make_range_no_check(common, &range, iova, len);
   612		if (ret)
   613			return ret;
   614	
   615		/* Calculate target page size and level for the leaves */
   616		if (pt_has_system_page(common) && pgsize == PAGE_SIZE && pgcount == 1) {
   617			PT_WARN_ON(!(pgsize_bitmap & PAGE_SIZE));
   618			if (log2_mod(iova | paddr, PAGE_SHIFT))
   619				return -ENXIO;
   620			map.leaf_pgsize_lg2 = PAGE_SHIFT;
   621			map.leaf_level = 0;
   622			single_page = true;
   623		} else {
   624			map.leaf_pgsize_lg2 = pt_compute_best_pgsize(
   625				pgsize_bitmap, range.va, range.last_va, paddr);
   626			if (!map.leaf_pgsize_lg2)
   627				return -ENXIO;
   628			map.leaf_level =
   629				pt_pgsz_lg2_to_level(common, map.leaf_pgsize_lg2);
   630		}
   631	
   632		ret = check_map_range(iommu_table, &range, &map);
   633		if (ret)
   634			return ret;
   635	
   636		PT_WARN_ON(map.leaf_level > range.top_level);
   637	
   638		do {
   639			if (single_page) {
   640				ret = pt_walk_range(&range, __map_single_page, &map);
   641				if (ret != -EAGAIN)
   642					break;
   643			}
   644	
   645			if (map.leaf_level == range.top_level)
   646				ret = pt_walk_range(&range, __map_range_leaf, &map);
   647			else
   648				ret = pt_walk_range(&range, __map_range, &map);
   649		} while (false);
   650	
   651		/*
   652		 * Table levels were freed and replaced with large items, flush any walk
   653		 * cache that may refer to the freed levels.
   654		 */
   655		if (!iommu_pages_list_empty(&iotlb_gather.freelist))
   656			iommu_iotlb_sync(&iommu_table->domain, &iotlb_gather);
   657	
   658		/* Bytes successfully mapped */
   659		PT_WARN_ON(!ret && map.oa - paddr != len);
   660		*mapped += map.oa - paddr;
   661		return ret;
