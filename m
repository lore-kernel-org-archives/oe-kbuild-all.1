tree:   https://git.linaro.org/people/vincent.guittot/kernel.git sched/pelt
head:   152b0b530094bc4aa9f2ba10e2046a1cf7c1cd25
commit: 152b0b530094bc4aa9f2ba10e2046a1cf7c1cd25 [1/1] sched/fair: reduce c=
ases for active balance

 fair.c |    4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -9444,9 +9444,9 @@ imbalanced_active_balance(struct lb_env
 	 */
 	if ((env->migration_type =3D=3D migrate_task) &&
 		(sd->nr_balance_failed > sd->cache_nice_tries+2))
-		return 1;
+		return true;
 =

-	return 0;
+	return false;
 }
 =

 static int need_active_balance(struct lb_env *env)
