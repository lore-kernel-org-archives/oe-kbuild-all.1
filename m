From: kbuild test robot <lkp@intel.com>

kernel/sched/fair.c:1607:9-10: WARNING: return of 0/1 in function 'load_too=
_imbalanced' with return type bool
kernel/sched/fair.c:9113:9-10: WARNING: return of 0/1 in function 'voluntar=
y_active_balance' with return type bool

 Return statements in functions returning bool should use
 true/false instead of 1/0.
Generated by: scripts/coccinelle/misc/boolreturn.cocci

Fixes: a2bcf50a05b9 ("sched/numa: replace runnable_load_avg by load_avg")
Signed-off-by: kbuild test robot <lkp@intel.com>
---

tree:   https://git.linaro.org/people/vincent.guittot/kernel.git sched/pelt
head:   72c9cba7acfa9d51fe5ced5ff3a3cde60c69e022
commit: a2bcf50a05b93817cf143756b6406c6cb5bc7a45 [3/5] sched/numa: replace =
runnable_load_avg by load_avg

 fair.c |   10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -1604,7 +1604,7 @@ static bool load_too_imbalanced(long src
 =

 	/* If dst node has spare capacity, there is no real load imbalance */
 	if (env->dst_stats.node_type =3D=3D node_has_spare)
-		return 0;
+		return false;
 =

 	/*
 	 * The load is corrected for the CPU capacity available on each node.
@@ -9110,7 +9110,7 @@ voluntary_active_balance(struct lb_env *
 	struct sched_domain *sd =3D env->sd;
 =

 	if (asym_active_balance(env))
-		return 1;
+		return true;
 =

 	/*
 	 * The dst_cpu is idle and the src_cpu CPU has only 1 CFS task.
@@ -9122,13 +9122,13 @@ voluntary_active_balance(struct lb_env *
 	    (env->src_rq->cfs.h_nr_running =3D=3D 1)) {
 		if ((check_cpu_capacity(env->src_rq, sd)) &&
 		    (capacity_of(env->src_cpu)*sd->imbalance_pct < capacity_of(env->dst_=
cpu)*100))
-			return 1;
+			return true;
 	}
 =

 	if (env->migration_type =3D=3D migrate_misfit)
-		return 1;
+		return true;
 =

-	return 0;
+	return false;
 }
 =

 static int need_active_balance(struct lb_env *env)
