   552	/**
   553	 * map_range() - Install translation for an IOVA range
   554	 * @iommu_table: Table to manipulate
   555	 * @iova: IO virtual address to start
   556	 * @paddr: Physical/Output address to start
   557	 * @len: Length of the range starting from @iova
   558	 * @prot: A bitmap of IOMMU_READ/WRITE/CACHE/NOEXEC/MMIO
   559	 * @gfp: GFP flags for any memory allocations
   560	 * @gather: Gather struct that must be flushed on return
   561	 *
   562	 * The range starting at IOVA will have paddr installed into it. The rage is
   563	 * automatically segmented into optimally sized table entries, and can have any
   564	 * valid alignment.
   565	 *
   566	 * On error the caller will probably want to invoke unmap on the range from iova
   567	 * up to the amount indicated by @mapped to return the table back to an
   568	 * unchanged state.
   569	 *
   570	 * Context: The caller must hold a write range lock that includes the whole
   571	 * range.
   572	 *
   573	 * Returns: -ERRNO on failure, 0 on success. The number of bytes of VA that were
   574	 * mapped are added to @mapped, @mapped is not zerod first.
   575	 */
   576	int DOMAIN_NS(map_pages)(struct iommu_domain *domain, unsigned long iova,
   577				 phys_addr_t paddr, size_t pgsize, size_t pgcount,
   578				 int prot, gfp_t gfp, size_t *mapped)
   579	{
   580		struct pt_iommu *iommu_table =
   581			container_of(domain, struct pt_iommu, domain);
   582		pt_vaddr_t pgsize_bitmap = iommu_table->domain.pgsize_bitmap;
   583		struct pt_common *common = common_from_iommu(iommu_table);
   584		struct iommu_iotlb_gather iotlb_gather;
   585		pt_vaddr_t len = pgsize * pgcount;
   586		struct pt_iommu_map_args map = {
   587			.iotlb_gather = &iotlb_gather,
   588			.oa = paddr,
   589			.leaf_pgsize_lg2 = log2_ffs(pgsize),
   590		};
   591		bool single_page = false;
   592		struct pt_range range;
   593		int ret;
   594	
   595		iommu_iotlb_gather_init(&iotlb_gather);
   596	
   597		if (WARN_ON(!(prot & (IOMMU_READ | IOMMU_WRITE))))
   598			return -EINVAL;
   599	
   600		/* Check the paddr doesn't exceed what the table can store */
 > 601		if ((sizeof(pt_oaddr_t) > sizeof(paddr) && paddr > PT_VADDR_MAX) ||
   602		    (common->max_oasz_lg2 != PT_VADDR_MAX_LG2 &&
   603		     oalog2_div(paddr, common->max_oasz_lg2)))
   604			return -ERANGE;
   605	
   606		ret = pt_iommu_set_prot(common, &map.attrs, prot);
   607		if (ret)
   608			return ret;
   609		map.attrs.gfp = gfp;
