tree:   https://android.googlesource.com/kernel/goldfish android-3.18
head:   dd54b61f1458c03f68fc019b4874d98f2f0ae3a5
commit: 8214bf079208b146e63cd0a3ce0ed335a87ce7b3 [396/1051] scripts/dtc: Ex=
port YYLOC global declaration
:::::: branch date: 5 weeks ago
:::::: commit date: 3 months ago

Please take the patch only if it's a positive warning. Thanks!

 rtnetlink.c |    3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

--- a/net/core/rtnetlink.c
+++ b/net/core/rtnetlink.c
@@ -1748,8 +1748,7 @@ static int do_setlink(const struct sk_bu
 		nla_for_each_nested(af, tb[IFLA_AF_SPEC], rem) {
 			const struct rtnl_af_ops *af_ops;
 =

-			if (!(af_ops =3D rtnl_af_lookup(nla_type(af))))
-				BUG();
+			BUG_ON(!(af_ops =3D rtnl_af_lookup(nla_type(af))));
 =

 			err =3D af_ops->set_link_af(dev, af);
 			if (err < 0)
