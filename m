  6346	
  6347	/*
  6348	 * The purpose of wake_affine() is to quickly determine on which CPU we can run
  6349	 * soonest. For the purpose of speed we only consider the waking and previous
  6350	 * CPU.
  6351	 *
  6352	 * wake_affine_idle() - only considers 'now', it check if the waking CPU is
  6353	 *			cache-affine and is (or	will be) idle.
  6354	 *
  6355	 * wake_affine_weight() - considers the weight to reflect the average
  6356	 *			  scheduling latency of the CPUs. This seems to work
  6357	 *			  for the overloaded case.
  6358	 */
  6359	static int
  6360	wake_affine_idle(int this_cpu, int prev_cpu, int sync)
  6361	{
  6362		/*
  6363		 * If this_cpu is idle, it implies the wakeup is from interrupt
  6364		 * context. Only allow the move if cache is shared. Otherwise an
  6365		 * interrupt intensive workload could force all tasks onto one
  6366		 * node depending on the IO topology or IRQ affinity settings.
  6367		 *
  6368		 * If the prev_cpu is idle and cache affine then avoid a migration.
  6369		 * There is no guarantee that the cache hot data from an interrupt
  6370		 * is more important than cache hot data on the prev_cpu and from
  6371		 * a cpufreq perspective, it's better to have higher utilisation
  6372		 * on one CPU.
  6373		 */
  6374		if (available_idle_cpu(this_cpu) && cpus_share_cache(this_cpu, prev_cpu))
  6375			return available_idle_cpu(prev_cpu) ? prev_cpu : this_cpu;
  6376	
  6377		if (sync && cpu_rq(this_cpu)->nr_running == 1)
  6378			return this_cpu;
  6379	
  6380		if (available_idle_cpu(prev_cpu))
  6381			return prev_cpu;
  6382	
  6383		/* The only running task is a short duration one. */
  6384		if (cpu_rq(this_cpu)->nr_running == 1 &&
> 6385		    is_short_task((struct task_struct *)cpu_curr(this_cpu)))
  6386			return this_cpu;
  6387	
  6388		return nr_cpumask_bits;
  6389	}
