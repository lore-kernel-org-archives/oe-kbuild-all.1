  1206	=

  1207		list_for_each_entry_safe(req, n, &dep->pending_list, list) {
  1208			struct dwc3	*dwc =3D dep->dwc;
  1209			int		ret;
  1210	=

  1211			ret =3D usb_gadget_map_request_by_dev(dwc->sysdev, &req->request,
  1212							    dep->direction);
  1213			if (ret)
  1214				return;
  1215	=

  1216			req->sg			=3D req->request.sg;
  1217			req->start_sg		=3D req->sg;
  1218			req->num_queued_sgs	=3D 0;
  1219			req->num_pending_sgs	=3D req->request.num_mapped_sgs;
  1220	=

  1221			if (req->num_pending_sgs > 0)
  1222				dwc3_prepare_one_trb_sg(dep, req);
  1223			else
  1224				dwc3_prepare_one_trb_linear(dep, req);
  1225	=

