ith page cache off the inode shrinker LRU

 truncate.c |    2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/mm/truncate.c
+++ b/mm/truncate.c
@@ -38,7 +38,7 @@ static bool __must_check __clear_shadow_
 =

 	xas_set_update(&xas, workingset_update_node);
 	if (xas_load(&xas) !=3D entry)
